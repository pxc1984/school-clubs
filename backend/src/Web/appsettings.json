{
    "ConnectionStrings": {
        "SchoolClubsDb": "Server=localhost;Port=5432;Database=db;Username=admin;Password=password;"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning",
            "Microsoft.Hosting.Lifetime": "Information"
        }
    },
    "AllowedHosts": "*",
    "Storage": {
        "S3": {
            "ServiceUrl": "http://localhost:9000",
            "AccessKey": "rustfsadmin",
            "SecretKey": "rustfsadmin",
            "Bucket": "schoolclubs",
            "CreateBucket": true
        }
    },
    "School": {
        "TimeZone": "Europe/Moscow"
    },
    "Statistics": {
        "Weights": {
            "Solved": 1,
            "SolvedWithRemarks": 0.75,
            "UnsolvedWithRemarks": 0.25,
            "Unsolved": 0
        }
    },
    "Auth": {
        "ConsentVersion": "1",
        "ServiceAdminPassword": "",
        "ServiceAdminLoginAttemptsPerMinute": 5,
        "SessionValidationInterval": "00:05:00",
        "Oidc": {
            "yandex": {
                "DisplayName": "Яндекс ID",
                "Protocol": "oauth2",
                "AuthorizationEndpoint": "https://oauth.yandex.ru/authorize",
                "TokenEndpoint": "https://oauth.yandex.ru/token",
                "UserInfoEndpoint": "https://login.yandex.ru/info?format=json",
                "UserInfoAuthScheme": "OAuth",
                "ClientId": "",
                "ClientSecret": "",
                "Scopes": [ "login:email", "login:info" ],
                "ClaimKeys": {
                    "sub": "id",
                    "email": "default_email",
                    "given_name": "first_name",
                    "family_name": "last_name",
                    "preferred_username": "login"
                },
                "TrustEmail": true
            },
            "telegram": {
                "DisplayName": "Telegram",
                "Authority": "https://oauth.telegram.org",
                "ClientId": "",
                "ClientSecret": "",
                "Scopes": [ "openid", "profile" ],
                "GetClaimsFromUserInfoEndpoint": false
            }
        }
    }
}
