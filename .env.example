# ==========
# Application
# ==========
Logging__LogLevel__Default=Information

# ==========
# Auth
# ==========
# пароль сервисного админа (/admin/login); пусто — сервисный вход выключен
Auth__ServiceAdminPassword=
# версия политики обработки ПДн: при смене все пользователи заново принимают согласие
Auth__ConsentVersion=1
# Яндекс ID (OIDC). Пустой ClientId — кнопка входа не показывается.
# Redirect URI в приложении Яндекса: <origin>/api/v1/auth/external/yandex/callback
Auth__Oidc__yandex__ClientId=
Auth__Oidc__yandex__ClientSecret=
# Telegram (OIDC). Client ID/Secret — @BotFather → Bot Settings → Web Login;
# там же Redirect URI: <origin>/api/v1/auth/external/telegram/callback
Auth__Oidc__telegram__ClientId=
Auth__Oidc__telegram__ClientSecret=

# Сколько прокси перед бэкендом дописывают X-Forwarded-For: 1 — traefik, 2 — nginx на хосте + traefik
ForwardedHeaders__ForwardLimit=1

# ==========
# PostgreSQL
# ==========
POSTGRES_DB=db
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
# опционально
DB_PORT=5432

# ==========
# S3 (RustFS) — файлы журналов
# ==========
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=schoolclubs
# опционально
S3_PORT=9000

# ==========
# Traefik
# ==========
# на сервере traefik слушает только 127.0.0.1:HTTP_PORT (за хостовым nginx)
HTTP_PORT=80
