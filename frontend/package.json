        "@sveltejs/adapter-node": "^5.5.7",
        "@sveltejs/kit": "^2.69.1",
        "@tailwindcss/vite": "^4.3.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/svelte": "^5.4.2",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^24.13.2",
        "bits-ui": "^2.19.5",
        "cn": "^0.4.0",
        "eslint": "^10.6.0",
        "eslint-plugin-svelte": "^3.20.0",
